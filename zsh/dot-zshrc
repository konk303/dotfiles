function git_color() {
  local git_info="$(__git_ps1 "%s")"
  if [[ $git_info == *"*"* ]] || [[ $git_info == *"+"* ]]; then
    echo "%{${fg[red]}%}"
  elif [[ $git_info == *"%"* ]]; then
    echo "%{${fg[yellow]}%}"
  else
    echo "%{${fg[green]}%}"
  fi
}
PROMPT="%{${fg_bold[cyan]}%}%#%{${reset_color}%} "
PROMPT2="%{${fg[blue]}%}%_> %{${reset_color}%}"
SPROMPT="%{${fg[red]}%}correct: %R -> %r [nyae]? %{${reset_color}%}"
function gcloud_config() {
  cat "$HOME/.config/gcloud/active_config" 2>/dev/null
}
RPROMPT='$(git_color)$(__git_ps1)%{${reset_color}%} %{${fg[yellow]}%}($(gcloud_config))%{${reset_color}%}[%{${fg_bold[cyan]}%}%~%{${reset_color}%}]%{${fg_bold[magenta]}%}%D %T%{${reset_color}%}'

# browser login only when gcloud or ADC credentials can't be refreshed
function gg-reauth() {
  local account=$(gcloud config get-value account 2>/dev/null)
  if gcloud auth print-access-token > /dev/null 2>&1 &&
     env -u GOOGLE_APPLICATION_CREDENTIALS gcloud auth application-default print-access-token > /dev/null 2>&1; then
    return 0
  fi
  gcloud auth login "$account" --update-adc --force
}

# keep ADC quota project in sync with the active configuration
function gg-quota() {
  local project="$1"
  local adc="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/application_default_credentials.json"
  [[ -z "$project" ]] && return 0
  [[ "$(jq -r '.quota_project_id // empty' "$adc" 2>/dev/null)" == "$project" ]] && return 0
  gcloud auth application-default set-quota-project "$project" > /dev/null 2>&1 ||
    echo "gg: could not set ADC quota project to $project" >&2
}

function gg() {
  local name="$1"
  if [[ -z "$name" ]]; then
    name=$(gcloud config configurations list --format="value(name)" | peco)
  fi
  if [[ -n "$name" ]]; then
    gcloud config configurations activate "$name"
    gg-reauth || return 1
    local project=$(gcloud config get-value project 2>/dev/null)
    gg-quota "$project"
    local cluster=$([[ -n "$project" ]] && kubectl config get-clusters | grep "$project")
    if [[ -n "$cluster" ]]; then
      kubectl config use-context "$cluster"
    fi
  fi
}
function gg-complete() {
  _values "gcloud config" $(gcloud config configurations list --format="value(name)")
}
compdef gg-complete gg


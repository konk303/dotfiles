# stolen from https://github.com/otaaaa/dotfiles/blob/master/zshrc
function keygen() {
  local length=12
  echo "$(openssl rand -base64 $length)"
}

function uuid() {
  uuidgen | tr \[:upper:\] \[:lower:\]
}

function ipv4() {
  ifconfig | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1'
}

